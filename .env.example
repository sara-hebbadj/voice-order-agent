# Copy to "Portfolio Projects/.env" (shared) or to this repo's .env, then fill in.
# Never commit .env. Variable names only here.

# --- OpenRouter (speech-to-text + text-to-speech) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Audio model IDs. Leave empty for the defaults in src/voice_agent/config.py. Lists:
#   https://openrouter.ai/api/v1/models?output_modalities=transcription
#   https://openrouter.ai/api/v1/models?output_modalities=speech
# Default STT: elevenlabs/scribe-v2 (others tried: openai/whisper-large-v3,
# openai/gpt-transcribe, openai/gpt-4o-transcribe)
MODEL_STT=
# Default TTS (the agent's voice): elevenlabs/eleven-flash-v2.5
MODEL_TTS=
# Voice names depend on the TTS model (see "supported_voices" in the list above).
# Default for elevenlabs/eleven-flash-v2.5: sarah
TTS_VOICE=
# Test-caller voices for evals/synthesize_audio.py. Default: google/gemini-3.8-flash-lite-tts
MODEL_TTS_CALLER=
# Optional: TTS price per 1M characters, used only by the budget guard during a run
# (20 for elevenlabs/eleven-flash-v2.5 is built in). Reported costs come from OpenRouter.
TTS_PRICE_PER_1M_CHARS=

# --- Orders + courier API ---
# Leave empty to run the mock API in-process. Set to use a running server, e.g. http://127.0.0.1:8001
ORDER_API_URL=

# --- Budget guard (US$) ---
MAX_COST_PER_RUN_USD=3

# --- Optional version 2 only (OpenAI Realtime, not built yet) ---
OPENAI_API_KEY=
