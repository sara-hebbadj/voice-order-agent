# Copy to "Portfolio Projects/.env" (shared) or to this repo's .env, then fill in.
# Never commit .env. Variable names only here.

# --- OpenRouter (speech-to-text + text-to-speech) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Audio model IDs (defaults in src/voice_agent/config.py; check https://openrouter.ai/models)
# e.g. MODEL_STT=openai/gpt-4o-transcribe  or  openai/whisper-large-v3
MODEL_STT=
# e.g. MODEL_TTS=openai/gpt-4o-mini-tts-2025-12-15
MODEL_TTS=
TTS_VOICE=alloy
# Optional: TTS price per 1M characters (from the model page) for cost estimates
TTS_PRICE_PER_1M_CHARS=

# --- Orders + courier API ---
# Leave empty to run the mock API in-process. Set to use a running server, e.g. http://127.0.0.1:8001
ORDER_API_URL=

# --- Budget guard (US$) ---
MAX_COST_PER_RUN_USD=3

# --- Optional version 2 only (OpenAI Realtime, not built yet) ---
OPENAI_API_KEY=
